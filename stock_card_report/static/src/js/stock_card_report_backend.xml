<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
  <t t-name="report_stock_card_html">
        <t t-call="report_buttons" />
        <div
            class="stock_card_reports_page"
            style="overflow: scroll;height: 100%;"
            t-ref="page"
        />
    </t>
  <t t-name="report_buttons">
        <div class="button_row">
            <button
                class="o_stock_card_reports_print btn btn-sm oe_button"
                t-on-click="() => this.onClickPrint()"
            >
        <i class="oi" data-icon="print" />
        Print
      </button>
            <button
                class="o_stock_card_reports_export btn btn-sm oe_button"
                t-on-click="() => this.onClickExport()"
            >
        <i class="oi" data-icon="download" />
        Export
      </button>
        </div>
    </t>
</templates>
